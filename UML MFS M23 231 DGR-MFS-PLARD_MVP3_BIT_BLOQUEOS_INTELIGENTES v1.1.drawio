bri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td width=&quot;64&quot; class=&quot;xl771&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; width: 48pt;&quot;&gt;pathParam&lt;br&gt;requerido&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&quot;cards&quot;&lt;/td&gt;&lt;td class=&quot;xl541&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 11pt; font-family: &amp;quot;Aptos Narrow&amp;quot;, sans-serif; vertical-align: bottom; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;20&quot; style=&quot;height: 15pt;&quot;&gt;&lt;td height=&quot;20&quot; class=&quot;xl769&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; color: rgb(0, 32, 96); font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap; text-align: center; height: 15pt;&quot;&gt;3&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;td width=&quot;64&quot; class=&quot;xl771&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; width: 48pt;&quot;&gt;&lt;/td&gt;&lt;td width=&quot;172&quot; class=&quot;xl771&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; width: 129pt;&quot;&gt;&lt;/td&gt;&lt;td class=&quot;xl770&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;Busca lock_id en la respuesta&lt;/td&gt;&lt;td class=&quot;xl541&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 11pt; font-family: &amp;quot;Aptos Narrow&amp;quot;, sans-serif; vertical-align: bottom; border: 0.5pt solid black; white-space: nowrap;&quot;&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="1665.57" x="924.43" y="-391" as="geometry" />
        </mxCell>
        <mxCell id="nZ6xe9aTNlLGeY8imGN8-1" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;strokeColor=default;" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;Funcionalidad:&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Consulta Unitaria de Bloqueos Inteligentes de una Tarjeta de Débito&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(BIT)&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;Alcance&lt;/b&gt;: MPV-Full Debit&amp;nbsp;&amp;nbsp;-&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Esta transacción permite consultar la información de bloqueos selectivos de forma unitaria de una tarjeta de débito a través de canales digitales.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Esta funcionalidad permite al cliente consultar la información de bloqueos inteligentes mediante la integración con el componente BIT, con el fin de conocer y gestionar las restricciones aplicadas al uso de su tarjeta de débito.&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;Reglas de negocio&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul data-start=&quot;303&quot; data-end=&quot;493&quot;&gt;&lt;li data-section-id=&quot;12m2cnx&quot; data-start=&quot;93&quot; data-end=&quot;145&quot;&gt;Aplica únicamente para Tarjetas de Débito (TDD).&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1v08wjz&quot; data-start=&quot;147&quot; data-end=&quot;368&quot;&gt;Los bloqueos inteligentes corresponden a bloqueos selectivos, los cuales incluyen:&lt;br&gt;&lt;ul data-start=&quot;236&quot; data-end=&quot;368&quot;&gt;&lt;li data-section-id=&quot;1ek37bx&quot; data-start=&quot;236&quot; data-end=&quot;264&quot;&gt;Compras en el extranjero&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1jzfs99&quot; data-start=&quot;267&quot; data-end=&quot;298&quot;&gt;Compras en terminales (POS)&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1cnsbos&quot; data-start=&quot;301&quot; data-end=&quot;330&quot;&gt;Retiro de efectivo en ATM&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;zvinoc&quot; data-start=&quot;333&quot; data-end=&quot;368&quot;&gt;Compras por internet o teléfono&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1e8njde&quot; data-start=&quot;370&quot; data-end=&quot;420&quot;&gt;Los bloqueos inteligentes no residen en Pampa. Las tarjetas de débito Pampa deben ser enroladas a solicitud del canal.&amp;nbsp;Las tarjetas PAMPA deber de ser previamente enroladas a BIT mediante la ejecución de otra transacción (trx LMWN).&lt;/li&gt;&lt;li data-section-id=&quot;ravo2f&quot; data-start=&quot;422&quot; data-end=&quot;581&quot;&gt;Las tarjetas de débito PLARD ya cuentan con el enrolamiento en BIT desde su origen.&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;uy3iuc&quot; data-start=&quot;583&quot; data-end=&quot;984&quot;&gt;Se implementa la lógica de enrutamiento que se orquesta mediante la validación en la de tabla de migración, consultando el estatus de migración de la tarjeta para determinar el flujo de la petición:&lt;/li&gt;&lt;ul data-start=&quot;801&quot; data-end=&quot;984&quot;&gt;&lt;li data-section-id=&quot;uy3iuc&quot; data-start=&quot;583&quot; data-end=&quot;984&quot;&gt;Si el product_id (PAN) no existe, se envía a admin-bit.&lt;/li&gt;&lt;li data-section-id=&quot;uy3iuc&quot; data-start=&quot;583&quot; data-end=&quot;984&quot;&gt;Si existe, se enruta mediante admin-bit-sidecar.&lt;/li&gt;&lt;/ul&gt;&lt;li data-section-id=&quot;zqdi4v&quot; data-start=&quot;986&quot; data-end=&quot;1105&quot;&gt;El componente de la Capa de Integración deberá permitir al canal intercomunicarse con BIT.&lt;br&gt;&lt;/li&gt;&lt;li data-section-id=&quot;1bu0jn3&quot; data-start=&quot;1107&quot; data-end=&quot;1229&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;BIT es el sistema responsable de la gestión de los bloqueos inteligentes.&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;b style=&quot;background-color: initial;&quot;&gt;Precondiciones:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;El cliente Santander debe contar con una Tarjeta de Débito.&lt;/li&gt;&lt;li&gt;La Tarjeta de Débito debe estar vigente y activa.&lt;/li&gt;&lt;li&gt;La Tarjeta de Débito debe estar asignada al cliente.&lt;/li&gt;&lt;li&gt;La Tarjeta de Débito debe estar vinculada a una cuenta activa.&lt;/li&gt;&lt;li&gt;El canal debe enviar un token válido para la autenticación de la solicitud.&lt;/li&gt;&lt;li&gt;La Capa de Integración requiere llave pública para validar el token.&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;El token de autenticación (kid) es obligatorio y debe ser válido para procesar la solicitud.&lt;br&gt;&lt;/span&gt;&lt;/li&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: initial;&quot;&gt;&lt;/b&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: initial;&quot;&gt;&lt;/b&gt;&lt;b style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: initial;&quot;&gt;&lt;/b&gt;&lt;/ul&gt;&lt;b style=&quot;background-color: initial; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Post-Condiciones:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: initial; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;ul type=&quot;disc&quot; style=&quot;margin-top: 0cm;&quot;&gt;&lt;li&gt;El canal muestra al cliente la información correspondiente a la respuesta de la solicitud de consulta especifica de bloqueo inteligente.&lt;/li&gt;&lt;li&gt;El canal recibe la respuesta de la operación de consulta de bloqueos solicitada.&lt;/li&gt;&lt;li&gt;La Capa de Integración registra el resultado del proceso en los logs del componente BIT.&lt;/li&gt;&lt;li&gt;La trazabilidad de la transacción queda registrada para fines de auditoría y control interno de Banco Santander.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="720" width="769" x="-809" y="-1112" as="geometry" />
        </mxCell>
        <mxCell id="nZ6xe9aTNlLGeY8imGN8-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#bac8d3;strokeColor=#23445d;" value="Funcionalidad" vertex="1">
          <mxGeometry height="40" width="769" x="-809" y="-1152" as="geometry" />
        </mxCell>
        <mxCell id="nZ6xe9aTNlLGeY8imGN8-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=15;fontStyle=1;align=center;fillColor=#bac8d3;strokeColor=#23445d;shadow=0;" value="Escenarios" vertex="1">
          <mxGeometry height="42" width="769" x="-809" y="-382" as="geometry" />
        </mxCell>
        <mxCell id="nZ6xe9aTNlLGeY8imGN8-4" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;strokeWidth=1;strokeColor=default;" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;strong data-start=&quot;201&quot; data-end=&quot;246&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;&lt;br&gt;&lt;/font&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;201&quot; data-end=&quot;246&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font&gt;Escenario 1: Consulta de Unitaria Bloqueos Inteligentes&lt;/font&gt;&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;El cliente, a través del canal digital, realiza la solicitud de consulta unitaria de un bloqueo inteligente específico asociado a su tarjeta de débito por identificador de bloqueo, contando con una tarjeta activa y un token de autenticación válido. Para ello, se&amp;nbsp;&lt;/span&gt;realiza la operativa de la funcionalidad&amp;nbsp;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent;&quot;&gt;enviando como parámetros de entrada&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;el identificador del producto (product_id), el tipo de producto (product_type = &quot;cards&quot;) y el identificador del bloqueo (lock_id).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-start=&quot;305&quot; data-end=&quot;579&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;La Capa de Integración realiza la validación del token recibido, verificando su vigencia, autenticidad y correspondencia con la llave pública (kid). Posteriormente,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;obtiene el cardID a partir del PAN&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, y enruta la solicitud al servicio correspondiente.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;305&quot; data-end=&quot;579&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Se consulta la tabla de migración de tarjetas en la base de datos para determinar el estatus de migración y definir el enrutamiento de la petición.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Si la tarjeta no es PLARD, se realiza la consulta de los bloqueos inteligentes asociados a la tarjeta de débito del cliente a través de la integración con el API del componente BIT, utilizando como valor de entrada el número de tarjeta (PAN).&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Si la tarjeta es PLARD,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;la consulta puede resolverse mediante el API PLARD Card Operability Control, el cual valida la información a partir del número de tarjeta como parámetro de entrada.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1230&quot; data-end=&quot;1434&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;La respuesta generada contiene la información del bloqueo inteligente consultado de manera unitaria, evitando retornar el conjunto completo de bloqueos.&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;La salida devuelve la información de un bloqueo inteligente especifico asociados a la tarjeta de débito.&lt;/span&gt;&lt;/p&gt;&lt;div&gt;&lt;p data-start=&quot;1436&quot; data-end=&quot;1510&quot;&gt;Finalmente, el canal muestra la información al cliente.&lt;/p&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p data-start=&quot;1230&quot; data-end=&quot;1434&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Consideraciones:&lt;/b&gt;&lt;/p&gt;&lt;ul data-start=&quot;668&quot; data-end=&quot;881&quot;&gt;&lt;li&gt;Este componente esta disponibilizado en el espacio del sistemas BIT&amp;nbsp;&lt;/li&gt;&lt;li&gt;El sistema BIT devuelve la respuesta a la Capa de Integración con la información de la lista de los bloqueos inteligentes de la tarjeta.&lt;/li&gt;&lt;li&gt;La Capa de Integración es responsable de la validación, el enrutamiento y la orquestación de la petición.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="518" width="769" x="-809" y="-338" as="geometry" />
        </mxCell>
        <mxCell id="oO6r5XZtMgdmoSWH2_7n-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEEEEE;strokeColor=#23445d;fontSize=14;fontStyle=1;align=left;" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: rgb(51, 51, 51); font-size: 12px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;CONSULTA DE BLOQUEO INTELIGENTE POR ID DEL BLOQUEO&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); background-color: transparent; font-size: 12px;&quot;&gt;Formato: Responce = http 200&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="79.11" width="1665.57" x="924.43" y="-218" as="geometry" />
        </mxCell>
