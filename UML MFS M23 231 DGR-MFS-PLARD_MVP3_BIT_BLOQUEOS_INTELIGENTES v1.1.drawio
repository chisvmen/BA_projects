        <mxCell id="QfxCjsJqA3jqfjUJRiMh-84" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=center;container=0;" value="&lt;div data-ccp-timestamp=&quot;1778268563549&quot; style=&quot;font-size: medium; font-weight: 400; text-align: start;&quot;&gt;&lt;table width=&quot;776&quot; style=&quot;border-collapse: collapse; width: 582pt;&quot;&gt;&lt;colgroup&gt;&lt;col width=&quot;100&quot; style=&quot;width: 75pt;&quot;&gt;&lt;col width=&quot;149&quot; style=&quot;width: 112pt;&quot;&gt;&lt;col width=&quot;272&quot; style=&quot;width: 204pt;&quot;&gt;&lt;col width=&quot;50&quot; style=&quot;width: 38pt;&quot;&gt;&lt;col width=&quot;205&quot; style=&quot;width: 154pt;&quot;&gt;&lt;/colgroup&gt;&lt;tbody&gt;&lt;tr height=&quot;20&quot; style=&quot;height: 15pt;&quot;&gt;&lt;td width=&quot;100&quot; height=&quot;20&quot; class=&quot;xl30&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-weight: 700; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; background: rgb(217, 225, 242); width: 75pt; height: 15pt;&quot;&gt;Secuencia&lt;br&gt;ejecución&lt;/td&gt;&lt;td width=&quot;149&quot; class=&quot;xl30&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-weight: 700; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; background: rgb(217, 225, 242); width: 112pt;&quot;&gt;API&lt;/td&gt;&lt;td width=&quot;272&quot; class=&quot;xl30&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-weight: 700; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; background: rgb(217, 225, 242); width: 204pt;&quot;&gt;Endpoint&lt;/td&gt;&lt;td width=&quot;50&quot; class=&quot;xl30&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-s