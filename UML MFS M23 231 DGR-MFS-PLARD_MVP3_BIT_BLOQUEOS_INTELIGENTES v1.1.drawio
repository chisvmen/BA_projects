        <mxCell id="QfxCjsJqA3jqfjUJRiMh-86" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;align=center;container=0;" value="&lt;div data-ccp-timestamp=&quot;1778268424807&quot; style=&quot;font-size: medium; font-weight: 400; text-align: start;&quot;&gt;&lt;table width=&quot;521&quot; style=&quot;border-collapse: collapse; width: 391pt;&quot;&gt;&lt;colgroup&gt;&lt;col width=&quot;100&quot; style=&quot;width: 75pt;&quot;&gt;&lt;col width=&quot;149&quot; style=&quot;width: 112pt;&quot;&gt;&lt;col width=&quot;272&quot; style=&quot;width: 204pt;&quot;&gt;&lt;/colgroup&gt;&lt;tbody&gt;&lt;tr height=&quot;20&quot; style=&quot;height: 15pt;&quot;&gt;&lt;td width=&quot;100&quot; height=&quot;20&quot; class=&quot;xl30&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-weight: 700; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; background: rgb(217, 225, 242); width: 75pt; height: 15pt;&quot;&gt;Secuencia ejecución&lt;/td&gt;&lt;td width=&quot;149&quot; class=&quot;xl30&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-weight: 700; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; background: rgb(217, 225, 242); width: 112pt;&quot;&gt;Nombre del Componente&lt;/td&gt;&lt;td width=&quot;272&quot; class=&quot;xl30&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-weight: 700; font-family: Calibri, sans-serif; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; background: rgb(217, 225, 242); width: 204pt;&quot;&gt;Transacciones&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;20&quot; style=&quot;height: 15pt;&quot;&gt;&lt;td height=&quot;20&quot; class=&quot;xl26&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; text-align: center; height: 15pt;&quot;&gt;2&lt;/td&gt;&lt;td width=&quot;149&quot; class=&quot;xl31&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border-top: none; border-right: 0.5pt solid black; border-bottom: 0.5pt solid black; border-left: 0.5pt solid black; border-image: initial; width: 112pt;&quot;&gt;Transaction Consumer&lt;/td&gt;&lt;td class=&quot;xl32&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border-top: none; border-right: 0.5pt solid black; border-bottom: 0.5pt solid black; border-left: 0.5pt solid black; border-image: initial; text-wrap-mode: nowrap;&quot;&gt;&lt;span class=&quot;font5&quot; style=&quot;font-size: 8pt;&quot;&gt;Llamada a una &lt;/span&gt;&lt;span class=&quot;font7&quot; style=&quot;font-size: 8pt; font-weight: 700;&quot;&gt;LKXX &lt;/span&gt;&lt;span class=&quot;font5&quot; style=&quot;font-size: 8pt;&quot;&gt;de Pampa/Gravity&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;20&quot; style=&quot;height: 15pt;&quot;&gt;&lt;td height=&quot;20&quot; class=&quot;xl26&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; text-align: center; height: 15pt;&quot;&gt;5&lt;/td&gt;&lt;td width=&quot;149&quot; class=&quot;xl19&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border: 0.5pt solid black; width: 112pt;&quot;&gt;ms-cat-utils&lt;/td&gt;&lt;td width=&quot;272&quot; class=&quot;xl19&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border: 0.5pt solid black; width: 204pt;&quot;&gt;Catálogos de Paises, Moneda...&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;20&quot; style=&quot;height: 15pt;&quot;&gt;&lt;td height=&quot;20&quot; class=&quot;xl26&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border: 0.5pt solid black; text-wrap-mode: nowrap; text-align: center; height: 15pt;&quot;&gt;6&lt;/td&gt;&lt;td width=&quot;149&quot; class=&quot;xl19&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border: 0.5pt solid black; width: 112pt;&quot;&gt;Transaction Consumer&lt;/td&gt;&lt;td width=&quot;272&quot; class=&quot;xl19&quot; style=&quot;padding-top: 1px; padding-right: 1px; padding-left: 1px; font-size: 8pt; font-family: Calibri; vertical-align: middle; border: 0.5pt solid black; width: 204pt;&quot;&gt;B402, B485&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
