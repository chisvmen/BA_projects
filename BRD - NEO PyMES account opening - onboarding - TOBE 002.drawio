        <mxCell id="eA_DwGnwA9SWp1Hrje4p-22" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;exitX=0.508;exitY=0.206;exitDx=0;exitDy=0;exitPerimeter=0;" value="">
